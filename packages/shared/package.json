{
  "name": "@remote-mcp/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "default": "./dist/process.js"
    },
    "./fileLock": {
      "types": "./dist/fileLock.d.ts",
      "default": "./dist/fileLock.js"
    },
    "./remote": {
      "types": "./dist/remote/index.d.ts",
      "default": "./dist/remote/index.js"
    },
    "./shell": {
      "types": "./dist/shell.d.ts",
      "default": "./dist/shell.js"
    },
    "./persistentJobs": {
      "types": "./dist/persistentJobs.d.ts",
      "default": "./dist/persistentJobs.js"
    },
    "./task-manager": {
      "types": "./dist/taskManager.d.ts",
      "default": "./dist/taskManager.js"
    },
    "./tool-surface": {
      "types": "./dist/toolSurface.d.ts",
      "default": "./dist/toolSurface.js"
    },
    "./output": {
      "types": "./dist/output.d.ts",
      "default": "./dist/output.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "zod": "^3.23.8"
  }
}
